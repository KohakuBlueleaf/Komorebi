build: no path of the build machine in the binaries

The X280 runtime objects and images are compiled by custom commands with their own
flags, which CMAKE_C_FLAGS does not reach: they get -ffile-prefix-map, so paths under the
source tree (the build directory and the compiler inside it too) are written relative to
it in their debug information and __FILE__ strings. The experimental NoC estimator named
the source tree as the root of its latency table; it now looks relative to the working
directory (the table is not part of an installed runtime either way).

--- a/tt_metal/fabric/experimental/x280/x280_image.cmake
+++ b/tt_metal/fabric/experimental/x280/x280_image.cmake
@@ -39,11 +39,13 @@
     -Wall
     -Werror
     -mcmodel=medany
+    -ffile-prefix-map=${PROJECT_SOURCE_DIR}=.
     -I${CMAKE_CURRENT_LIST_DIR}/include
 )
 set(_x280_asflags
     ${_x280_target_flags}
     -nostdlib
+    -ffile-prefix-map=${PROJECT_SOURCE_DIR}=.
     -I${CMAKE_CURRENT_LIST_DIR}/include
 )
 # Neither per-hart entry object zeroes .bss, so images linking one must carry none. The linker
--- a/tt_metal/impl/experimental/noc_estimator/CMakeLists.txt
+++ b/tt_metal/impl/experimental/noc_estimator/CMakeLists.txt
@@ -14,6 +14,6 @@
         ${PROJECT_SOURCE_DIR}/tt_metal/impl
 )
 
-target_compile_definitions(tt_metal_noc_estimator PRIVATE NOC_ESTIMATOR_ROOT_DIR="${PROJECT_SOURCE_DIR}")
+target_compile_definitions(tt_metal_noc_estimator PRIVATE NOC_ESTIMATOR_ROOT_DIR=".")
 
 target_link_libraries(tt_metal_noc_estimator PRIVATE yaml-cpp::yaml-cpp)
