// refused: a race, two actions on one place, one a write, with no edge between them (Order, state and failure)
module order

tile [32, 32]
format f32

program P {
    handler write(x: tensor<f32>) @on(group) {
        let part = partition(x.tiles(0, 64), worker.rank, group.size)
        let out = sink(part, block = 1)
        for xb in stream(part, block = 1) {
            out.push(xb * 2.0)
        }
    }

    handler read(x: tensor<f32>) -> u32 @on(group) {
        var blocks: u32 = 0
        for xb in stream(partition(x.tiles(0, 64), worker.rank, group.size), block = 1) {
            blocks += 1
        }
        return blocks
    }
}

control order(x: tensor<f32>, y: tensor<f32>) {
    let a = invoke(P.write(x), on = group(0, 8))
    let b = invoke(P.read(x), on = group(8, 8))      // no edge with a: a race on x
    let c = invoke(P.read(y), on = group(8, 8))      // no edge with a: fine, a leaves y
    let d = invoke(
        P.read(x),
        on = group(8, 8),
        after = [a],
    )                                                // sees every write of a
    await d
}
