// refused: an unknown name (The pipeline: program compile checks names and types)
module scale

tile [32, 32]
format bf16

program Scale {
    handler run(x: tensor<bf16>, y: tensor<bf16>, k: f32) @on(group) {
        let src = partition(x.tiles(0, 64), worker.rank, group.size)
        let dst = partition(y.tiles(0, 64), worker.rank, group.size)
        let out = sink(dst, block = 1)
        for xb in stream(src, block = 1) {
            out.push(times(xb, k))
        }
    }
}
