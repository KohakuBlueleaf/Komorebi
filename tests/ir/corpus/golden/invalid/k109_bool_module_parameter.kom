// refused: a boolean is not a type of a parameter, of a module's as of a handler's (Types and data)
module flag

tile [32, 32]
format u32

param ON: bool = true @bind(build)

program Flag {
    state @scope(worker) @lifetime(program) {
        seen: u32[1] @export
    }

    handler mark() @on(group) {
        seen[0] = 1
    }
}
