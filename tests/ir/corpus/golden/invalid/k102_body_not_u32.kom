// refused: a body is given as u32 scalars, and this state member is of f32 (Dynamic runs)
module rays

tile [4, 4]
format u32

requires {
    dynamic
}

program Rays {
    message Ray @body(16) { id: u32 }

    state @scope(worker) @lifetime(program) {
        note: f32[4]
    }

    run trace(count: u32) @dynamic {
        seed {
            note.zero()
            send(Ray { id: count }, to = worker.rank, body = note)
        }
        on Ray(m) {
            consume m
        }
    }
}
