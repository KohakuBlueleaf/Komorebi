// refused: the body of Ray does not fit Hit, whose body is smaller (Dynamic runs)
module rays

tile [4, 4]
format u32

requires {
    dynamic
}

program Rays {
    message Ray @body(16) { id: u32 }
    message Hit @body(8) { id: u32 }

    run trace(count: u32) @dynamic {
        seed {
            send(Ray { id: count }, to = worker.rank)
        }
        on Ray(m) {
            forward(m, as = Hit, to = worker.rank)
        }
        on Hit(h) {
            consume h
        }
    }
}
