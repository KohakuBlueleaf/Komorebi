// refused: let is single assignment (section 12)
module once

tile [32, 32]
format u32

program Once {
    handler blocks(x: tensor<u32>, tiles: u32) -> u32 @on(group) {
        let walked: u32 = 0
        for xb in stream(partition(x.tiles(0, tiles), worker.rank, group.size), block = 1) {
            walked += 1
        }
        return walked
    }
}
