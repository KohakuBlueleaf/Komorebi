// refused: a value reduce gives only the leader, used under three terms joined by `&&`, none on the rank (a reading the build uses: how the reference interpreter runs a program)
module conditions

tile [32, 32]
format f32

program P {
    handler h(x: tensor<f32>, y: tensor<f32>, n: u32) @on(group) {
        var acc: tile<f32> = zeros
        for xb in stream(partition(x.tiles(0, n), worker.rank, group.size), block = 1) {
            acc += xb
        }
        let whole = reduce(acc, with = sum)
        if n > 0 && n < 9 && n != 3 {
            store y.tiles(0, 1) <- whole
        }
    }
}
