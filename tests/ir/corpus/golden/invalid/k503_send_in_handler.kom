// refused: send outside a dynamic run (Dynamic runs)
module walk

tile [32, 32]
format u32

requires {
    dynamic
}

program Walk {
    message Visit { id: u32, hops: u32 }

    handler start(count: u32) @on(group) {
        for i in range(count) {
            send(Visit { id: i, hops: 4 }, to = worker.rank)
        }
    }

    run walk(count: u32) @dynamic {
        seed {
            for i in range(count) {
                send(Visit { id: i, hops: 4 }, to = worker.rank)
            }
        }
        on Visit(m) {
            consume m
        }
    }
}
