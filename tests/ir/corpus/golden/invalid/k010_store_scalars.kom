// refused: named in the language, not built yet; a store of scalars (Handler bodies)
module count

tile [32, 32]
format u32

program Count {
    handler blocks(x: tensor<u32>, y: tensor<u32>, tiles: u32) @on(group) {
        var walked: u32 = 0
        for xb in stream(
            partition(x.tiles(0, tiles), worker.rank, group.size),
            block = 1,
        ) {
            walked += 1
        }
        store y.tiles(worker.rank, 1) <- walked
    }
}
