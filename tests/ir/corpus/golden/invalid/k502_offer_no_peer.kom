// refused: an offer to a rank that is not a declared peer; this run declares no peers (Dynamic runs)
module ring

tile [32, 32]
format u32

requires {
    dynamic
}

program Ring {
    message Tick { step: u32 }

    run ring(count: u32) @dynamic {
        seed {
            send(Tick { step: 0 }, to = worker.rank)
        }
        on Tick(m) {
            let next = (worker.rank + 1) % group.size
            let went = offer(Tick { step: m.step + 1 }, to = next)
            if went == false {
                forward(m, with = { step: m.step + 1 }, to = next)  // busy: queue it
            } else {
                consume m
            }
        }
    }
}
