// refused: a member that a body reads and no body of the program fills (Programs, state, handlers)
module gain

tile [32, 32]
format bf16

program Gain {
    state @scope(worker) @lifetime(program) {
        calls: u32[4] @export
    }

    handler apply(tiles: u32) @on(group) {
        calls.bump(0)
        calls[1] = tiles
    }
}
