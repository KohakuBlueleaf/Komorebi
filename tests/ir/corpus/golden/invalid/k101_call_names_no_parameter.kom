// refused: an operand given by name names a parameter of the callee; scale has no parameter s (Compute functions)
module named

tile [32, 32]
format f32

func scale(a: tile<f32>, k: f32) -> tile<f32> {
    return a * k
}

program P {
    handler run(x: tensor<f32>, y: tensor<f32>, k: f32) @on(group) {
        let out = sink(y.tiles(0, 1), block = 1)
        for xb in stream(x.tiles(0, 1)) {
            out.push(scale(a = xb, s = k))
        }
    }
}
