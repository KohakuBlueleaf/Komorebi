// refused: a handler reads a state member of tiles of another tile shape (Module)
module shapes

tile [32, 32]
tile [16, 16]
format f32

program P {
    state @scope(worker) @lifetime(program) @tile(16, 16) {
        table: tile<f32>[1]
        calls: u32[1]
    }

    handler fill(g: tensor<f32>) @on(group) @tile(16, 16) {
        table.fill(stream(g.tiles(0, 1), block = 1))
    }

    handler apply(x: tensor<f32>, y: tensor<f32>, n: u32) @on(group) {
        calls[0] = n
        let gain = table[0]
        let out = sink(partition(y.tiles(0, n), worker.rank, group.size), block = 1)
        for xb in stream(partition(x.tiles(0, n), worker.rank, group.size), block = 1) {
            out.push(xb * gain)
        }
    }
}
