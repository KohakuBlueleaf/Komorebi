// refused: @body takes a whole number of bytes above 0 and a multiple of 4 (Dynamic runs)
module rays

tile [4, 4]
format u32

requires {
    dynamic
}

program Rays {
    message Ray @body(6) { id: u32 }

    run trace(count: u32) @dynamic {
        seed {
            send(Ray { id: count }, to = worker.rank)
        }
        on Ray(m) {
            consume m
        }
    }
}
