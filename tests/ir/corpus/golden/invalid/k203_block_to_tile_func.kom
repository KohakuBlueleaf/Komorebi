// refused: a block of n tiles is tile<F>[n]; giving it to a function on one tile is a type error (Handler bodies)
module blocks

tile [32, 32]
format f32

func times(a: tile<f32>, k: f32) -> tile<f32> {
    return a * k
}

program Scale {
    handler run(x: tensor<f32>, y: tensor<f32>, k: f32, tiles: u32) @on(group) {
        var acc: tile<f32> = zeros
        for xb in stream(partition(x.tiles(0, tiles), worker.rank, group.size), block = 1) {
            acc += xb
        }
        let every = gather(acc)
        if worker.is_leader {
            store y.tiles(0, 1) <- times(every, k)
        }
    }
}
