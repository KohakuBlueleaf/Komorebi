// refused: named in the language, not built yet; all_gather (Handler bodies)
module every

tile [32, 32]
format f32

program Every {
    handler collect(x: tensor<f32>, y: tensor<f32>, tiles: u32) @on(group) {
        var acc: tile<f32> = zeros
        for xb in stream(partition(x.tiles(0, tiles), worker.rank, group.size), block = 1) {
            acc += xb
        }
        let all = all_gather(acc)
        store y.tiles(worker.rank, 1) <- acc
    }
}
