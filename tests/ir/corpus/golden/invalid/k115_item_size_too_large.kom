// refused: the size of an item is past what a u32 holds (Types and data)
module views

tile [32, 32]
format u32

program Views {
    state @scope(worker) @lifetime(program) {
        hit: u32[4]
    }

    handler put(results: tensor<u32>) @on(group) {
        hit.zero()
        results.items(size = 99999999999999999999999).put(hit, at = worker.rank)
    }
}
