// refused: a collective under a branch on the rank, its condition an `&&` (a reading the build uses: how the reference interpreter runs a program)
module conditions

tile [32, 32]
format f32

program P {
    handler h(x: tensor<f32>, y: tensor<f32>, n: u32) @on(group) {
        var acc: tile<f32> = zeros
        for xb in stream(partition(x.tiles(0, n), worker.rank, group.size), block = 1) {
            acc += xb
        }
        let whole = reduce(acc, with = sum)
        if worker.rank == 0 && n > 0 {
            sync(publish = [])
        }
    }
}
