// refused: named in the language, not built yet; as = on a forward (Dynamic runs)
module rays

tile [32, 32]
format u32

requires {
    dynamic
}

program Rays {
    message Ray { id: u32 }
    message Hit { id: u32 }

    run trace(count: u32) @dynamic {
        seed {
            for i in range(count) {
                send(Ray { id: i }, to = worker.rank)
            }
        }
        on Ray(m) {
            forward(m, as = Hit, to = worker.rank)
        }
        on Hit(h) {
            consume h
        }
    }
}
