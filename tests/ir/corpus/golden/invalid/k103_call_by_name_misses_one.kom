// refused: by name, every parameter of the callee is given; the invocation does not give k (Control programs)
module named

tile [32, 32]
format f32

program P {
    handler run(x: tensor<f32>, y: tensor<f32>, k: f32) @on(group) {
        let out = sink(y.tiles(0, 1), block = 1)
        for xb in stream(x.tiles(0, 1)) {
            out.push(xb * k)
        }
    }
}

control drive(x: tensor<f32>, y: tensor<f32>) {
    let a = invoke(P.run(y = y, x = x), on = group(0, 1))
    await a
}
