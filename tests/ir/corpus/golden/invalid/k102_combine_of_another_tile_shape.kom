// refused: a reduce names a combine of another tile shape (Module)
module shapes

tile [32, 32]
tile [16, 16]
format f32

combine add(a: tile<f32>, b: tile<f32>) -> tile<f32> @commutative @tile(16, 16) {
    return a + b
}

program P {
    handler total(x: tensor<f32>, y: tensor<f32>, n: u32) @on(group) {
        var acc: tile<f32> = zeros
        for xb in stream(partition(x.tiles(0, n), worker.rank, group.size), block = 1) {
            acc += xb
        }
        let whole = reduce(acc, with = add)
        if worker.is_leader {
            store y.tiles(0, 1) <- whole
        }
    }
}
