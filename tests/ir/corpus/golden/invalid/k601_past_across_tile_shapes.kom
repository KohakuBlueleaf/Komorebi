// refused: past(y) reads what a call of another tile shape wrote (Chains)
module steps

tile [32, 32]
tile [16, 16]
format f32

program Steps {
    handler scale(x: tensor<f32>, y: tensor<f32>, n: u32) @on(group) {
        let out = sink(partition(y.tiles(0, n), worker.rank, group.size), block = 1)
        for xb in stream(partition(x.tiles(0, n), worker.rank, group.size), block = 1) {
            out.push(xb + xb)
        }
    }

    handler copy(y: tensor<f32>, z: tensor<f32>, n: u32) @on(group) @tile(16, 16) {
        let out = sink(partition(z.tiles(0, n), worker.rank, group.size), block = 1)
        for yb in stream(partition(y.tiles(0, n), worker.rank, group.size), block = 1) {
            out.push(yb)
        }
    }

    chain steps(x: tensor<f32>, y: tensor<f32>, z: tensor<f32>) @on(group) {
        call scale(x, y, 4)
        call copy(past(y), z, 16)
    }
}
