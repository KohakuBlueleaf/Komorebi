// refused: a broadcast along a row or a column needs a handler on a grid (Handler bodies)
module rows

tile [32, 32]
format bf16

program Rows {
    handler spread(x: tensor<bf16>, y: tensor<bf16>, tiles: u32) @on(group) {
        let b = broadcast(along = row, sender = 0)
        if b.is_sender {
            for xb in stream(x.tiles(0, tiles), block = 1) {
                b.cast(xb, word = 0)
            }
        } else {
            let out = sink(y.tiles(worker.rank * tiles, tiles), block = 1)
            for xb, tag in b.arrive() {
                out.push(xb)
            }
        }
    }
}
