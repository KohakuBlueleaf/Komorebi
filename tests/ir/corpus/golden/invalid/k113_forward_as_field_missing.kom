// refused: a forward as Hit gives no value for its field sum (Dynamic runs)
module rays

tile [4, 4]
format u32

requires {
    dynamic
}

program Rays {
    message Ray { id: u32 }
    message Hit { id: u32, sum: u32 }

    run trace(count: u32) @dynamic {
        seed {
            send(Ray { id: count }, to = worker.rank)
        }
        on Ray(m) {
            forward(m, as = Hit, to = worker.rank)
        }
        on Hit(h) {
            consume h
        }
    }
}
