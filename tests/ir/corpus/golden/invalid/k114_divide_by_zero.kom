// refused: an integer divided by a zero the text shows (Order, state and failure)
module share

tile [32, 32]
format u32

program Share {
    handler blocks(x: tensor<u32>, tiles: u32) -> u32 @on(group) {
        var walked: u32 = 0
        for xb in stream(
            partition(x.tiles(0, tiles), worker.rank, group.size),
            block = 1,
        ) {
            walked += 1
        }
        return walked / 0
    }
}
