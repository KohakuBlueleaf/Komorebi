// refused: invoke outside a control program (Control programs)
module solve

tile [32, 32]
format bf16

program Solver {
    handler step(x: tensor<bf16>) @on(group) @exclusive {
        let part = partition(x.tiles(0, 64), worker.rank, group.size)
        let out = sink(part, block = 1)
        for xb in stream(part, block = 1) {
            out.push(xb * 0.5)
        }
    }

    handler again(x: tensor<bf16>) @on(group) {
        let a = invoke(Solver.step(x), on = group(0, 8))
    }
}
