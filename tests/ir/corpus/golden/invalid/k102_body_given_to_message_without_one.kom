// refused: body = on a send of a message type with no @body (Dynamic runs)
module rays

tile [4, 4]
format u32

requires {
    dynamic
}

program Rays {
    message Ray { id: u32 }

    state @scope(worker) @lifetime(program) {
        note: u32[4]
    }

    run trace(count: u32) @dynamic {
        seed {
            note.zero()
            send(Ray { id: count }, to = worker.rank, body = note)
        }
        on Ray(m) {
            consume m
        }
    }
}
