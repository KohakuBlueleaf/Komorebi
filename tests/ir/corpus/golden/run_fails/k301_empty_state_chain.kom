// fails at the run: a read of empty state; the chain's first call reads calls before its second call fills it (Programs, state, handlers)
// run: the control program first, on a freshly loaded module
module gain

tile [32, 32]
format bf16

program Gain {
    state @scope(worker) @lifetime(program) {
        calls: u32[4]  @export
    }

    handler start() @on(group) {
        calls.zero()
    }

    handler apply(tiles: u32) @on(group) {
        calls.bump(0)
        calls[1] = tiles
    }

    chain twice(tiles: u32) @on(group) {
        call apply(tiles)
        call start()
    }
}

control first() {
    let a = invoke(Gain.twice(4), on = group(0, 4))
    await a
}
