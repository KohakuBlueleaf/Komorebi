// two tile shapes in one module: each handler addresses the tensor in its own (Module)
module shaped

tile [2, 2]
tile [4, 4]
format f32

func twice(a: tile<f32>) -> tile<f32> {
    return a + a
}

func twice_wide(a: tile<f32>) -> tile<f32> @tile(4, 4) {
    return a + a
}

program Shaped {
    // in tiles of [2, 2]
    handler fine(x: tensor<f32>, y: tensor<f32>, tiles: u32) @on(group) {
        let src = partition(x.tiles(0, tiles), worker.rank, group.size)
        let dst = sink(partition(y.tiles(0, tiles), worker.rank, group.size), block = 1)
        for xb in stream(src, block = 1) {
            dst.push(twice(xb))
        }
    }

    // the same elements, in tiles of [4, 4]
    handler coarse(x: tensor<f32>, y: tensor<f32>, tiles: u32) @on(group) @tile(4, 4) {
        let src = partition(x.tiles(0, tiles), worker.rank, group.size)
        let dst = sink(partition(y.tiles(0, tiles), worker.rank, group.size), block = 1)
        for xb in stream(src, block = 1) {
            dst.push(twice_wide(xb))
        }
    }
}
