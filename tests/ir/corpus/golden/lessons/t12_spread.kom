module spread

tile [32, 32]
format f32

requires {
    islands >= 2
}

combine add(a: tile<f32>, b: tile<f32>) -> tile<f32> @commutative {
    return a + b
}

program Spread {
    state @scope(worker) @lifetime(program) {
        seen: u32[4]  @export
    }

    handler locate() @on(group) {
        seen[0] = island.count
        seen[1] = island.of(worker.id)
        let next = (worker.rank + 1) % group.size
        if island.crosses(group.id(next)) {
            seen[2] = 1
        } else {
            seen[2] = 0
        }
        seen[3] = island.hops(group.id(next))
    }

    // each worker adds up its part and writes it into the copy of its own island
    handler learn(x: tensor<f32>, w: tensor<f32> @replicated, tiles: u32) @on(group) {
        let src = partition(x.tiles(0, tiles), worker.rank, group.size)
        var acc: tile<f32> = zeros
        for xb in stream(src, block = 1) { acc += xb }
        store w.tiles(worker.rank, 1) <- acc
    }
}

// make every island's copy the sum of all of them
control merge(w: tensor<f32> @replicated) {
    reduce_to(w, to = 0, with = add)
    broadcast_from(w, from = 0)
}
