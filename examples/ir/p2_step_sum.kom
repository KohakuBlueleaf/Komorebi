// StepHandlers of tests/ir/tensix/steps_sum.py, as the DSL frontend writes it
module stephandlers

tile [32, 32]
format f32

program StepHandlers {
    handler sum(s: tensor<f32>, t: tensor<f32>, tiles: u32) @on(group) {
        let part = partition(s.tiles(0, tiles), worker.rank, group.size)
        var total: tile<f32> = zeros
        for tile_ in stream(part, block = 1) {
            total += tile_
        }
        let whole = reduce(total, with = sum)
        if worker.is_leader {
            store t.tiles(0, 1) <- whole
        }
    }
}
