// Scale of tests/ir/tensix/t1_class.py, as the DSL frontend writes it
module scale

tile [32, 32]
format bf16

func times(a: tile<bf16>, k: f32) -> tile<bf16> {
    return a * k
}

program Scale {
    handler run(
        x: tensor<bf16>,
        y: tensor<bf16>,
        first: u32,
        tiles: u32,
        k: f32,
    ) @on(group) {
        let src = partition(x.tiles(first, tiles), worker.rank, group.size)
        let src_y = partition(y.tiles(first, tiles), worker.rank, group.size)
        let out = sink(src_y, block = 1)
        for xb in stream(src, block = 1) {
            out.push(times(xb, k))
        }
    }
}
