module rows

tile [32, 32]
format bf16

requires {
    group = grid
}

program Rows {
    handler spread(x: tensor<bf16>, y: tensor<bf16>, tiles: u32) @on(grid[4, 8]) {
        let b = broadcast(along = row, sender = 0)
        if b.is_sender {
            for xb in stream(x.tiles(worker.row * tiles, tiles), block = 1) {
                b.cast(xb, word = worker.row)
            }
        } else {
            let mine = y.tiles((worker.row * 8 + worker.col) * tiles, tiles)
            let out = sink(mine, block = 1)
            for xb, tag in b.arrive() {
                out.push(xb)
            }
        }
    }
}
