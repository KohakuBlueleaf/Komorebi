// @FN@: emitted by komorebi.dsl.tile from its unit program (fp32 Dst); math CPU only.
// Writes no constant register; the caller acquires Dst and waits.
// @K@_bits: a run-time scalar, a float32's bits.
#pragma once

#include <stdint.h>

#ifdef TRISC_MATH
namespace km_tile {

    inline void @FN@_init() {
        TTI_SFPCONFIG(0, 15, 1);
        ckernel::addr_mod_t{.srca = {.incr = 0}, .srcb = {.incr = 0}, .dest = {.incr = 0}}.set(ADDR_MOD_7);
        TTI_SETRWC(0, 0, 0, 0, 0, 15);
        ckernel::addr_mod_t{.srca = {.incr = 0}, .srcb = {.incr = 0}, .dest = {.incr = 2}}.set(ADDR_MOD_6);
    }

    inline void @FN@(const uint32_t dst, const uint32_t @K@_bits) {
#if defined(ARCH_WORMHOLE)
        TTI_SETC16(ADDR_MOD_SET_Base_ADDR32, 1);
#endif
        ckernel::math::set_dst_write_addr<DstTileShape::Tile32x32, UnpackDestination::SrcRegs>(dst);
        TTI_STALLWAIT(ckernel::p_stall::STALL_SFPU, ckernel::p_stall::MATH);
        TT_SFPLOADI(0, 2, @K@_bits & 0xFFFFu);
        TT_SFPLOADI(0, 8, @K@_bits >> 16);
        for (uint32_t face = 0; face < 4; ++face) {
#if defined(ARCH_WORMHOLE)
            TTI_REPLAY(0, 4, 1, 1);
#else
            TTI_REPLAY(0, 3, 1, 1);
#endif
#if defined(ARCH_WORMHOLE)
            TTI_SFPLOAD(1, 0, 3, 0);
#else
            TTI_SFPLOAD(1, 0, 7, 0);
#endif
            TTI_SFPMUL(0, 1, 9, 1, 0);
#if defined(ARCH_WORMHOLE)
            TTI_SFPNOP;
#endif
#if defined(ARCH_WORMHOLE)
            TTI_SFPSTORE(1, 0, 2, 0);
#else
            TTI_SFPSTORE(1, 0, 6, 0);
#endif
#pragma GCC unroll 7
            for (uint32_t row = 0; row < 7; ++row) {
#if defined(ARCH_WORMHOLE)
                TTI_REPLAY(0, 4, 0, 0);
#else
                TTI_REPLAY(0, 3, 0, 0);
#endif
            }
            TTI_SETRWC(0, 4, 8, 0, 0, 4);
            TTI_SETRWC(0, 4, 8, 0, 0, 4);
        }
        TTI_SETRWC(0, 0, 0, 0, 0, 4);
#if defined(ARCH_WORMHOLE)
        TTI_STALLWAIT(ckernel::p_stall::STALL_CFG, ckernel::p_stall::WAIT_SFPU);
        TTI_SETC16(ADDR_MOD_SET_Base_ADDR32, 0);
#endif
    }

}  // namespace km_tile
#endif
